# DJANGO
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
# 1 = desarrollo (muestra errores detallados), 0 = produccion
DEBUG=1
# Dominios permitidos separados por coma (en Render agregar el dominio .onrender.com)
ALLOWED_HOSTS=localhost,127.0.0.1
JWT_SECRET=cambiar-por-otra-clave-larga

# POSTGRES
# En Docker el host es el NOMBRE DEL SERVICIO (base_de_datos) y el puerto el interno (5432)
# Sin Docker (python manage.py runserver) el host es localhost
POSTGRES_DB=inventario
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=base_de_datos
POSTGRES_PORT=5432

# ADMIN INICIAL (lo crea iniciar.sh si no existe)
DJANGO_SUPERUSER_CORREO=admin@almacen.com
DJANGO_SUPERUSER_NOMBRE=Administrador
DJANGO_SUPERUSER_PASSWORD=

# AWS S3
BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
