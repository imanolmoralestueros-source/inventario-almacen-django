meta {
  name: Login credenciales incorrectas
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "{{consultaCorreo}}",
    "password": "incorrecta"
  }
}

docs {
  Debe responder 401 con el mismo mensaje que si el correo no existiera.
}
